# Firebase Cloud Functions (2nd Gen) Environment Variables for Yeme Bingo Push System
# Copy this file to `functions/.env` before deploying with `firebase deploy --only functions`.

# Realtime Database URL used by Yeme Bingo frontend (`index.html`)
FIREBASE_DATABASE_URL=https://wow-878fc-default-rtdb.firebaseio.com

# Base Web/PWA URL for WebPush click deep links (?screen=<screen>)
APP_BASE_URL=https://wow-878fc.web.app

# Android notification channel ID (matches MainActivity.CHANNEL_ID)
ANDROID_CHANNEL_ID=yeme_bingo_alerts

# Optional Telegram Bot broadcasting helper (leave blank to disable Telegram mirroring)
# Create a bot via @BotFather and set channel/group ID (e.g. -1001234567890 or @your_channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
